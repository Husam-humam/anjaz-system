# Django
SECRET_KEY=change-me-to-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=anjaz.inss.local,inss.local,localhost,127.0.0.1

# Database
DB_NAME=anjaz_db
DB_USER=anjaz_user
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend — يصل إلى الـ backend عبر nginx على HTTPS (نفس النطاق)
NEXT_PUBLIC_API_URL=https://anjaz.inss.local/api
NEXT_PUBLIC_WS_URL=wss://anjaz.inss.local/ws

# CORS — أصول مسموحة (HTTPS)
CORS_ALLOWED_ORIGINS=https://anjaz.inss.local,https://inss.local

# Seed Data (development only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_FULL_NAME=مدير النظام

# Nginx
NGINX_SERVER_NAME=anjaz.inss.local
CLIENT_MAX_BODY_SIZE=10M

# Security — عند العمل خلف nginx على HTTPS:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://anjaz.inss.local,https://inss.local
USE_X_FORWARDED_HOST=True

# Rate limiting على تسجيل الدخول (لكل عنوان IP)
# True في الإنتاج، يمكن تعطيله مؤقتاً في التطوير.
LOGIN_THROTTLE_ENABLED=True
# الصيغة: N/period حيث period ∈ {second, minute, hour, day}
# مثلاً: 5/minute = خمس محاولات في الدقيقة لكل IP
LOGIN_THROTTLE_RATE=5/minute

# Cache backend — Redis (مشترك بين كل workers، يحفظ عدّاد rate-limit صحيحاً)
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://redis:6379/1

# External Organization System
EXTERNAL_ORG_API_URL=http://localhost:8001/api/external/
EXTERNAL_ORG_API_KEY=change-me-to-the-api-key-from-external-system
EXTERNAL_ORG_API_TIMEOUT=15
# Host header override (لو docker يصل عبر hostname مختلف عن ALLOWED_HOSTS الخارجي)
EXTERNAL_ORG_HOST_HEADER=
